# --- HTTP ---
HTTP_PORT=8080

# --- Database ---
POSTGRES_USER=audio
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=audio

# --- Auth ---
JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Uploads ---
MAX_UPLOAD_MB=2048

# --- Whisper ---
# Models: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v3
# cpu | cuda
WHISPER_DEVICE=cpu
# int8 (cpu), float16 (gpu), float32
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=el

# --- Chunking ---
CHUNK_SECONDS=900
OVERLAP_SECONDS=10

# --- Worker resource cap ---
WORKER_MEMORY_LIMIT=8g

# --- LLM (summarization) ---
# Options: ollama | openai | anthropic | none
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://ollama:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
