# Copy to .env and fill in real values. .env is gitignored.

# --- HTTP ---
HTTP_PORT=8080

# --- Database ---
POSTGRES_USER=audio
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=audio

# --- Auth ---
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Uploads ---
MAX_UPLOAD_MB=2048

# --- Whisper transcription ---
# Models: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# cpu | cuda
WHISPER_DEVICE=cpu
# int8 (cpu), float16 (gpu), float32
WHISPER_COMPUTE_TYPE=int8
# ISO-639-1 (e.g. el, en, fr). Empty/"auto" lets Whisper detect.
WHISPER_LANGUAGE=el

# --- Chunking ---
CHUNK_SECONDS=900
OVERLAP_SECONDS=10

# --- Worker resource cap ---
WORKER_MEMORY_LIMIT=8g

# --- Diarization (optional) ---
# When true, jobs can opt in via the diarize flag on upload.
# Requires accepting pyannote/speaker-diarization-3.1 on HuggingFace and an HF_TOKEN.
DIARIZATION_ENABLED=false
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cpu
HF_TOKEN=

# --- LLM (summarization) ---
# Options: ollama | openai | anthropic | none
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://ollama:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Demo login (dev convenience) ---
# When both are set, the login page shows a "Use demo credentials" button
# and a copy-pasteable hint. Leave blank in production.
DEMO_USERNAME=
DEMO_PASSWORD=

# --- Microsoft Graph / Teams import (optional) ---
# Register an app at portal.azure.com > Entra ID > App registrations.
# Redirect URI must match MS_REDIRECT_URI exactly (Web platform, https required
# for any non-localhost host). Add both prod and localhost URIs in Entra so
# dev keeps working.
# Delegated permissions: User.Read, Calendars.Read, OnlineMeetings.Read,
#                       OnlineMeetings.ReadWrite, offline_access
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Use your tenant ID, or "common" for multi-tenant + personal accounts.
MS_TENANT_ID=common
# Production (split-domain layout: frontend on root, backend on api.*):
MS_REDIRECT_URI=https://api.audiointel.draxis.gr/teams/auth/callback
# Local dev alternative: http://localhost:8080/api/teams/auth/callback
# Where to send the user after successful Microsoft sign-in (frontend URL).
MS_POST_LOGIN_REDIRECT=https://audiointel.draxis.gr/teams
# Local dev alternative: http://localhost:8080/teams

# --- Production deployment (split domains) ---
# When the backend runs on a different origin than the frontend, the browser
# needs CORS allowance and the frontend needs the full API URL baked in at
# build time. For the localhost single-origin setup, leave both blank.
NUXT_PUBLIC_API_BASE=https://api.audiointel.draxis.gr
CORS_ALLOW_ORIGINS=https://audiointel.draxis.gr

# --- Logging ---
LOG_LEVEL=INFO
